  - '0'
- - rx_s2p
  - '0'
  - ofdm_fft
  - '0'
- - ofdm_fft
  - '0'
  - raw
  - '0'
- - ofdm_fft
  - '0'
  - fde
  - '0'
- - raw
  - '0'
  - p2s_raw
  - '0'
- - fde
  - '0'
  - p2s_eq
  - '0'
- - p2s_raw
  - '0'
  - const
  - '0'
- - p2s_eq
  - '0'
  - const
  - '1'
- - ofdm_fft
  - '0'
  - mag2
  - '0'
- - mag2

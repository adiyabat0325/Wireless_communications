options:
  parameters:
    author: NUM Wireless Communication Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    description: Numbered text packets -> GNU Radio OFDM Transmitter -> HackRF Pro.
    generate_options: qt_gui
    id: lab4_hackrf_ofdm_tx
    output_language: python
    run: 'True'
    run_options: prompt
    title: 'Lab 4b - OFDM packet transmitter (HackRF Pro #1)'
    window_size: 1400, 1000
    comment: ''
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: 2e6
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 100
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    value: 433.92e6
    comment: Use only a frequency allowed in your lab / country
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 170
    rotation: 0
    state: enabled
- name: fft_len
  id: variable
  parameters:
    value: '64'
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 240
    rotation: 0
    state: enabled
- name: cp_len
  id: variable
  parameters:
    value: '16'
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 310
    rotation: 0
    state: enabled
- name: packet_len
  id: variable
  parameters:
    value: '64'
    comment: bytes per packet
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 100
    rotation: 0
    state: enabled
- name: len_key
  id: variable
  parameters:
    value: '"packet_len"'
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 170
    rotation: 0
    state: enabled
- name: occupied_carriers
  id: variable
  parameters:
    value: (list(range(-26, -21)) + list(range(-20, -7)) + list(range(-6, 0)) + list(range(1, 7)) + list(range(8, 21)) + list(range(22, 27)),)
    comment: 48 data subcarriers (DC = 0 is not used)
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 240
    rotation: 0
    state: enabled
- name: pilot_carriers
  id: variable
  parameters:
    value: ((-21, -7, 7, 21),)
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 310
    rotation: 0
    state: enabled
- name: pilot_symbols
  id: variable
  parameters:
    value: ((1, 1, 1, -1),)
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 380
    rotation: 0
    state: enabled
- name: tx_vga
  id: variable_qtgui_range
  parameters:
    label: '"TX VGA gain [dB]"'
    rangeType: int
    value: '10'
    start: '0'
    stop: '47'
    step: '1'
    widget: counter_slider
    gui_hint: 0,0,1,1
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 100
    rotation: 0
    state: enabled
- name: bb_amp
  id: variable_qtgui_range
  parameters:
    label: '"Baseband amplitude"'
    rangeType: float
    value: '0.05'
    start: '0.005'
    stop: '0.3'
    step: '0.005'
    widget: counter_slider
    gui_hint: 0,1,1,1
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 180
    rotation: 0
    state: enabled
- name: payload_src
  id: blocks_vector_source_x
  parameters:
    type: byte
    vector: list(b"".join(((("NUM OFDM LAB seq=%04d | Hello from HackRF Pro TX" % i).ljust(packet_len - 1) + "\n").encode() for i in range(1000))))
    tags: '[]'
    repeat: 'True'
    vlen: '1'
    comment: 1000 numbered text packets, repeated forever
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 420
    rotation: 0
    state: enabled
- name: to_packets
  id: blocks_stream_to_tagged_stream
  parameters:
    type: byte
    vlen: '1'
    packet_len: packet_len
    len_tag_key: len_key
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 228
    - 420
    rotation: 0
    state: enabled
- name: ofdm_tx
  id: digital_ofdm_tx
  parameters:
    fft_len: fft_len
    cp_len: cp_len
    packet_len_key: len_key
    occupied_carriers: occupied_carriers
    pilot_carriers: pilot_carriers
    pilot_symbols: pilot_symbols
    sync_word1: None
    sync_word2: None
    header_mod: '"BPSK"'
    payload_mod: '"QPSK"'
    rolloff: '0'
    scramble_bits: 'False'
    log: 'False'
    comment: 'Default 802.11a-like layout: 48 data + 4 pilot subcarriers

      Try payload_mod = BPSK / QPSK / 8-PSK'
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 480
    - 400
    rotation: 0
    state: enabled
- name: tx_scale
  id: blocks_multiply_const_vxx
  parameters:
    type: complex
    const: bb_amp
    vlen: '1'
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
    - 420
    rotation: 0
    state: enabled
- name: hackrf_tx
  id: soapy_hackrf_sink
  parameters:
    type: fc32
    dev_args: '""'
    samp_rate: samp_rate
    bandwidth: '0'
    center_freq: center_freq
    amp: 'False'
    vga: tx_vga
    comment: 'dev_args: leave empty for one HackRF; with two HackRFs on one PC use serial=<number from hackrf_info>

      amp=False: keep the +14 dB RF amplifier OFF in the lab'
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 960
    - 400
    rotation: 0
    state: enabled
- name: spec
  id: qtgui_freq_sink_x
  parameters:
    type: complex
    name: '"TX baseband spectrum"'
    fftsize: '1024'
    fc: center_freq
    bw: samp_rate
    average: '0.2'
    ymin: '-120'
    ymax: '-20'
    grid: 'True'
    nconnections: '1'
    gui_hint: 1,0,1,1
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 960
    - 560
    rotation: 0
    state: enabled
- name: tscope
  id: qtgui_time_sink_x
  parameters:
    type: complex
    name: '"TX baseband (OFDM bursts)"'
    size: '4096'
    srate: samp_rate
    ymin: '-0.3'
    ymax: '0.3'
    grid: 'True'
    nconnections: '1'
    entags: 'False'
    gui_hint: 1,1,1,1
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 960
    - 680
    rotation: 0
    state: enabled
connections:
- - payload_src
  - '0'
  - to_packets
  - '0'
- - to_packets
  - '0'
  - ofdm_tx
  - '0'
- - ofdm_tx
  - '0'
  - tx_scale
  - '0'
- - tx_scale
  - '0'
  - hackrf_tx
  - '0'
- - tx_scale
  - '0'
  - spec
  - '0'
- - tx_scale
  - '0'
  - tscope
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.9.2

options:
  parameters:
    author: NUM Wireless Communication Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    description: 'GNU Radio OFDM Transmitter/Receiver through a software channel: check the packet link before using the HackRF Pro.'
    generate_options: qt_gui
    id: lab4_ofdm_packets_sim
    output_language: python
    run: 'True'
    run_options: prompt
    title: Lab 4a - OFDM packet link (simulation, no hardware)
    window_size: 1400, 1000
    comment: ''
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: 2e6
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 100
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    value: 433.92e6
    comment: Use only a frequency allowed in your lab / country
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 170
    rotation: 0
    state: enabled
- name: fft_len
  id: variable
  parameters:
    value: '64'
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 240
    rotation: 0
    state: enabled
- name: cp_len
  id: variable
  parameters:
    value: '16'
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 310
    rotation: 0
    state: enabled
- name: packet_len
  id: variable
  parameters:
    value: '64'
    comment: bytes per packet
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 100
    rotation: 0
    state: enabled
- name: len_key
  id: variable
  parameters:
    value: '"packet_len"'
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 170
    rotation: 0
    state: enabled
- name: occupied_carriers
  id: variable
  parameters:
    value: (list(range(-26, -21)) + list(range(-20, -7)) + list(range(-6, 0)) + list(range(1, 7)) + list(range(8, 21)) + list(range(22, 27)),)
    comment: 48 data subcarriers (DC = 0 is not used)
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 240
    rotation: 0
    state: enabled
- name: pilot_carriers
  id: variable
  parameters:
    value: ((-21, -7, 7, 21),)
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 310
    rotation: 0
    state: enabled
- name: pilot_symbols
  id: variable
  parameters:
    value: ((1, 1, 1, -1),)
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 168
    - 380
    rotation: 0
    state: enabled
- name: noise_amp
  id: variable_qtgui_range
  parameters:
    label: '"Noise amplitude"'
    rangeType: float
    value: '0.01'
    start: '0'
    stop: '0.2'
    step: '0.002'
    widget: counter_slider
    gui_hint: 0,0,1,1
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 100
    rotation: 0
    state: enabled
- name: cfo_sc
  id: variable_qtgui_range
  parameters:
    label: '"CFO [x subcarrier spacing]"'
    rangeType: float
    value: '0.3'
    start: '-3'
    stop: '3'
    step: '0.05'
    widget: counter_slider
    gui_hint: 0,1,1,1
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 180
    rotation: 0
    state: enabled
- name: payload_src
  id: blocks_vector_source_x
  parameters:
    type: byte
    vector: list(b"".join(((("NUM OFDM LAB seq=%04d | Hello from HackRF Pro TX" % i).ljust(packet_len - 1) + "\n").encode() for i in range(1000))))
    tags: '[]'
    repeat: 'True'
    vlen: '1'
    comment: 1000 numbered text packets, repeated forever
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 420
    rotation: 0
    state: enabled
- name: to_packets
  id: blocks_stream_to_tagged_stream
  parameters:
    type: byte
    vlen: '1'
    packet_len: packet_len
    len_tag_key: len_key
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 228
    - 420
    rotation: 0
    state: enabled
- name: ofdm_tx
  id: digital_ofdm_tx
  parameters:
    fft_len: fft_len
    cp_len: cp_len
    packet_len_key: len_key
    occupied_carriers: occupied_carriers
    pilot_carriers: pilot_carriers
    pilot_symbols: pilot_symbols
    sync_word1: None
    sync_word2: None
    header_mod: '"BPSK"'
    payload_mod: '"QPSK"'
    rolloff: '0'
    scramble_bits: 'False'
    log: 'False'
    comment: 'Default 802.11a-like layout: 48 data + 4 pilot subcarriers

      Try payload_mod = BPSK / QPSK / 8-PSK'
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 480
    - 400
    rotation: 0
    state: enabled
- name: tx_scale
  id: blocks_multiply_const_vxx
  parameters:
    type: complex
    const: '0.05'
    vlen: '1'
    comment: 'OFDM has a high PAPR: keep the baseband amplitude small'
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
    - 420
    rotation: 0
    state: enabled
- name: throttle
  id: blocks_throttle2
  parameters:
    type: complex
    samples_per_second: samp_rate
    vlen: '1'
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 940
    - 420
    rotation: 0
    state: enabled
- name: chan
  id: channels_channel_model
  parameters:
    noise_voltage: noise_amp
    freq_offset: cfo_sc/fft_len
    epsilon: '1.0'
    taps: '[1.0, 0, 0, 0.3j]'
    seed: '0'
    block_tags: 'True'
    comment: Multipath + AWGN + CFO
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 400
    rotation: 0
    state: enabled
- name: ofdm_rx
  id: digital_ofdm_rx
  parameters:
    fft_len: fft_len
    cp_len: cp_len
    packet_len_key: '"rx_len"'
    occupied_carriers: occupied_carriers
    pilot_carriers: pilot_carriers
    pilot_symbols: pilot_symbols
    sync_word1: None
    sync_word2: None
    header_mod: '"BPSK"'
    payload_mod: '"QPSK"'
    scramble_bits: 'False'
    log: 'False'
    comment: Must use the SAME parameters as the transmitter
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 560
    rotation: 0
    state: enabled
- name: print_packets
  id: blocks_file_sink
  parameters:
    file: '"/dev/stdout"'
    type: byte
    vlen: '1'
    unbuffered: 'True'
    append: 'False'
    comment: Decoded packets are printed in the GRC console
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1400
    - 560
    rotation: 0
    state: enabled
- name: save_packets
  id: blocks_file_sink
  parameters:
    file: '"rx_packets_sim.txt"'
    type: byte
    vlen: '1'
    unbuffered: 'True'
    append: 'False'
    comment: 'Packet error rate: python3 lab4_per.py rx_packets_sim.txt'
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1400
    - 660
    rotation: 0
    state: enabled
- name: spec
  id: qtgui_freq_sink_x
  parameters:
    type: complex
    name: '"Channel output spectrum"'
    fftsize: '1024'
    fc: '0'
    bw: samp_rate
    average: '0.2'
    ymin: '-100'
    ymax: '-20'
    grid: 'True'
    nconnections: '1'
    gui_hint: 1,0,1,2
    comment: ''
  states:
    alias: ''
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1400
    - 360
    rotation: 0
    state: enabled
connections:
- - payload_src
  - '0'
  - to_packets
  - '0'
- - to_packets
  - '0'
  - ofdm_tx
  - '0'
- - ofdm_tx
  - '0'
  - tx_scale
  - '0'
- - tx_scale
  - '0'
  - throttle
  - '0'
- - throttle
  - '0'
  - chan
  - '0'
- - chan
  - '0'
  - ofdm_rx
  - '0'
- - ofdm_rx
  - '0'
  - print_packets
  - '0'
- - ofdm_rx
  - '0'
  - save_packets
  - '0'
- - chan
  - '0'
  - spec
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.9.2
